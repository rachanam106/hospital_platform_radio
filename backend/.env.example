DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
DATABASE_URL=
# Set DATABASE_URL to your private PostgreSQL connection string for deployment.
DATABASE_SSLMODE=prefer
PRIVATE_IMAGE_STORAGE_ROOT=C:/var/lib/radiology-clinic/private-images
IMAGE_UPLOAD_MAX_BYTES=104857600
IMAGE_UPLOAD_BATCH_MAX_BYTES=524288000
DICOM_MAX_DECODED_BYTES=536870912
